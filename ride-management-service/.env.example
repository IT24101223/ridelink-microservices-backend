# Copy to .env and set the Atlas database user's password.
# Never commit the real .env file.
MONGODB_URI=mongodb+srv://it24102021_db_user:<url-encoded-password>@cluster0.ue11zov.mongodb.net/ride_management?retryWrites=true&w=majority&appName=Cluster0

# JWT shared secret (must match Account Service).
# Generate: openssl rand -base64 32
JWT_SECRET=<your-base64-encoded-32-byte-secret>

# URLs of sibling microservices
DRIVER_SERVICE_URL=http://localhost:8082
FARE_SERVICE_URL=http://localhost:8084

# Stub downstream services for local demo (MongoDB Atlas is still required)
SPRING_PROFILES_ACTIVE=stub
