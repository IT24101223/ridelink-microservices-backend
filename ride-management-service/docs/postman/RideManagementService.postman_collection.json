{
  "info": {
    "name": "RideLink – Ride Management Service",
    "_postman_id": "ridelink-ride-mgmt-v1",
    "description": "Full test suite for the Ride Management Service (port 8083). Includes positive and negative cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",          "value": "http://localhost:8083" },
    { "key": "passenger_token",   "value": "<PASSENGER_JWT>" },
    { "key": "driver_token",      "value": "<DRIVER_JWT>" },
    { "key": "admin_token",       "value": "<ADMIN_JWT>" },
    { "key": "ride_id",           "value": "" }
  ],
  "item": [
    {
      "name": "1 – Create Ride (PASSENGER) → 201",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('Has id', () => pm.expect(body.id).to.be.a('string'));",
        "pm.test('Status ASSIGNED', () => pm.expect(body.status).to.eql('ASSIGNED'));",
        "pm.collectionVariables.set('ride_id', body.id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"pickupAddress\": \"University Gate, London\",\n  \"pickupLat\": 51.5074,\n  \"pickupLng\": -0.1278,\n  \"destinationAddress\": \"King's Cross Station\",\n  \"destinationLat\": 51.5309,\n  \"destinationLng\": -0.1233\n}" },
        "url": "{{base_url}}/api/rides"
      }
    },
    {
      "name": "2 – Get Ride by ID (PASSENGER) → 200",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Correct id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('ride_id')));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{passenger_token}}" }],
        "url": "{{base_url}}/api/rides/{{ride_id}}"
      }
    },
    {
      "name": "3 – Accept Ride (DRIVER) → 200",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Status ACCEPTED', () => pm.expect(pm.response.json().status).to.eql('ACCEPTED'));"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
        "url": "{{base_url}}/api/rides/{{ride_id}}/accept"
      }
    },
    {
      "name": "4 – Start Ride (DRIVER) → 200",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Status IN_PROGRESS', () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
        "url": "{{base_url}}/api/rides/{{ride_id}}/start"
      }
    },
    {
      "name": "5 – Complete Ride (DRIVER) → 200",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Status COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));",
        "pm.test('Has finalFare', () => pm.expect(pm.response.json().finalFare).to.not.be.null);",
        "pm.test('Has paymentId', () => pm.expect(pm.response.json().paymentId).to.not.be.null);"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
        "url": "{{base_url}}/api/rides/{{ride_id}}/complete"
      }
    },
    {
      "name": "6 – Cancel Ride (PASSENGER) → 200",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OR 409 (already completed)', () => {\n  pm.expect(pm.response.code).to.be.oneOf([200, 409]);\n});"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"reason\": \"Changed my mind\"}" },
        "url": "{{base_url}}/api/rides/{{ride_id}}/cancel"
      }
    },
    {
      "name": "NEG – Create with missing pickupAddress → 400",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 400', () => pm.response.to.have.status(400));",
        "pm.test('Has details array', () => pm.expect(pm.response.json().details).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"pickupAddress\": \"\",\n  \"pickupLat\": 51.5074,\n  \"pickupLng\": -0.1278,\n  \"destinationAddress\": \"Station\",\n  \"destinationLat\": 51.5155,\n  \"destinationLng\": -0.1415\n}" },
        "url": "{{base_url}}/api/rides"
      }
    },
    {
      "name": "NEG – Create without token → 401",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 401', () => pm.response.to.have.status(401));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"pickupAddress\":\"A\",\"pickupLat\":51.5,\"pickupLng\":-0.1,\"destinationAddress\":\"B\",\"destinationLat\":51.6,\"destinationLng\":-0.2}" },
        "url": "{{base_url}}/api/rides"
      }
    },
    {
      "name": "NEG – Accept as wrong DRIVER → 403",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 403', () => pm.response.to.have.status(403));"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
        "url": "{{base_url}}/api/rides/00000000-0000-0000-0000-000000000000/accept"
      }
    },
    {
      "name": "NEG – Invalid state transition → 409",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 409', () => pm.response.to.have.status(409));"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
        "url": "{{base_url}}/api/rides/{{ride_id}}/accept"
      }
    },
    {
      "name": "NEG – Get all rides as PASSENGER → 403",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 403', () => pm.response.to.have.status(403));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{passenger_token}}" }],
        "url": "{{base_url}}/api/rides"
      }
    },
    {
      "name": "ADMIN – Get all rides (paginated) → 200",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Has content array', () => pm.expect(pm.response.json().content).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": {
          "raw": "{{base_url}}/api/rides?page=0&size=10",
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" }
          ]
        }
      }
    }
  ]
}
